# ---------------------------------------------
# TEMPLATE CONFIGURATION - SAFE TO COMMIT
# ---------------------------------------------
# Copy this file to ".env" and fill in your real API keys:
#
#     Windows PowerShell :  copy .env.example .env
#     macOS / Linux      :  cp .env.example .env
#
# The real ".env" file is ignored by git. Never commit actual API keys.
# ---------------------------------------------

# NewsAPI key - https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# OpenWeatherMap API key - https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweather_api_key_here
