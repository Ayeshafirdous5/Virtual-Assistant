# ---------------------------------------------
# TEMPLATE CONFIGURATION - SAFE TO COMMIT
# ---------------------------------------------
# Copy this file to ".env" and fill in your real API keys:
#
#     Windows PowerShell :  copy .env.example .env
#     macOS / Linux      :  cp .env.example .env
#
# The real ".env" file is ignored by git. Never commit actual API keys.
# ---------------------------------------------

# NewsAPI key - https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# OpenWeatherMap API key - https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ---------------------------------------------
# OPTIONAL TUNING - SAFE TO OMIT
# ---------------------------------------------
# Everything below already has a working default, shown in the comment. Uncomment
# a line only if you want to change it. Nothing here is required: a .env holding
# only the two keys above is a complete, working setup.

#NEWS_COUNTRY=us
#NEWS_HEADLINE_COUNT=3
#WEATHER_CITY=Hyderabad

# Voice output. Voice mode only; ignored in text mode.
#TTS_RATE=130
#TTS_VOICE_NAME=voice name

# Seconds before any outgoing HTTP call gives up.
#REQUEST_TIMEOUT=10

# DEBUG, INFO, WARNING or ERROR
#LOG_LEVEL=INFO

# ---------------------------------------------
# OPTIONAL AI RESPONSES (OFF BY DEFAULT)
# ---------------------------------------------
# When the assistant does not recognise something as a command, it can
# optionally ask an AI service for a short conversational reply.
#
# This is entirely optional. With AI_ENABLED unset or false - which is the
# default - the assistant behaves exactly as it did before, and never
# contacts any AI service.
#
# Command routing stays rule-based either way: a recognised command is always
# handled by the existing NLU and tools, and AI is only ever asked about input
# that is NOT a command. AI cannot run tools or commands.
#
# To enable it, fill in AI_API_KEY and set AI_ENABLED=true.
# Use any OpenAI-compatible endpoint via AI_BASE_URL.

#AI_ENABLED=true
#AI_API_KEY=your_ai_api_key_here
#AI_MODEL=gpt-4o-mini
#AI_BASE_URL=https://api.openai.com/v1

# Seconds to wait for a reply before falling back. Keep this short: the
# assistant should answer the user promptly or use its normal reply.
#AI_TIMEOUT=8

#AI_MAX_TOKENS=200
